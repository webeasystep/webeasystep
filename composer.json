{
  "name": "fakhr/cms",
  "type": "project",
  "description": "the New CMS 2025",
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "codeigniter4/framework": "^4.6.0",
    "codeigniter4/settings": "^2.2",
    "codeigniter4/shield": "^1.0",
    "laminas/laminas-escaper": "^2.14",
    "mpdf/mpdf": "8.1.6",
    "phpoffice/phpspreadsheet": "^1.15",
    "psr/log": "^3.0"
  },
  "config": {
    "platform-check": false,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "require-dev": {
    "kint-php/kint": "^5.0.3",
    "codeigniter/coding-standard": "^1.5",
    "fakerphp/faker": "*"
  },
  "scripts": {
    "test": "phpunit"
  }
}
